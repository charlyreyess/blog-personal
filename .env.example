# Copia este archivo como .env.local y rellena los valores. NUNCA subas .env.local al repositorio.

# URL pública del sitio (en Vercel: https://tu-dominio.vercel.app)
NEXT_PUBLIC_SITE_URL=

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Formulario de contacto: los mensajes llegan a tu correo mediante Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Opcional, cuando verifiques tu dominio en Resend (ej. "Portafolio <hola@tudominio.com>")
CONTACT_FROM=
